{
  "name": "pulse-cf",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "build": "vite build",
    "check": "node --check src/worker.js && npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler d1 migrations apply pulse-cf --remote && wrangler deploy"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "vite": "^7.2.0",
    "wrangler": "^4.41.0"
  }
}
